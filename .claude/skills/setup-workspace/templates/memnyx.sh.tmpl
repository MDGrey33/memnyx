# memnyx shell helpers — GENERATED by /setup-workspace (init/sync).
# Do not edit: this file is overwritten on every sync. Sourced from your shell
# profile via a managed block. POSIX-safe — works under sh, dash, ksh, bash, and zsh.

# Where is the workspace? Prefer the folder this file actually sits in, so a
# workspace that was copied or moved, or a launcher pulled in from another
# machine's checkout, finds its own folder instead of the path baked in when the
# file was generated. bash, zsh and ksh93 can say where a sourced file lives;
# dash (and mksh, pdksh) cannot, so they keep the baked path. A folder only
# counts if it holds .claude/.workspace, so a copy sourced from somewhere random
# never guesses. The folder is reported as its physical path (symlinks resolved),
# the same form `mmn <slug>` uses for the project folder.
#
# Every `$(cd … && pwd -P)` in this file is written `\cd … >/dev/null 2>&1`. The
# backslash skips a `cd` alias (Omarchy aliases `cd` to zoxide's `zd`, which
# prints an icon line and the path when given `--`), and the redirect drops
# anything a `cd` function prints. Without both, the noise lands in the captured
# path and the check after it fails silently: no hooks, or no project. The
# `cd` into the project before launching is `\cd` too, so an alias cannot send
# Claude to another folder (zoxide does not record that jump). A `cd`
# function still runs, so one that fails but returns 0 is not caught.
#
# This runs only once the file is being sourced. The line in your shell profile
# that sources it holds an absolute path, so after moving a workspace re-run
# `launcher.py --wire-profile`; until then the shell skips the file and `mmn` is
# not found.
#
# The baked value is shell-quoted by launcher.py (shlex.quote) — do NOT add
# quotes here.
_mmn_baked_ws={{workspace_path}}
_mmn_self=
if [ -n "${ZSH_VERSION:-}" ]; then
  eval '_mmn_self=${(%):-%x}'
elif [ -n "${BASH_VERSION:-}" ]; then
  _mmn_self="${BASH_SOURCE:-}"
elif [ -n "${KSH_VERSION:-}" ] && ( eval ': ${.sh.version}' ) >/dev/null 2>&1; then
  # ksh93 only. mksh and pdksh set KSH_VERSION too but have no ${.sh.file}; the
  # probe runs in a subshell so an unsupported substitution cannot end this shell.
  eval '_mmn_self=${.sh.file}'
fi
_mmn_found=
if [ -n "$_mmn_self" ]; then
  case "$_mmn_self" in
    */*) _mmn_found=$(CDPATH= \cd -- "${_mmn_self%/*}/.." >/dev/null 2>&1 && pwd -P) ;;
    *)   _mmn_found=$(CDPATH= \cd -- .. >/dev/null 2>&1 && pwd -P) ;;
  esac
fi
if [ -n "$_mmn_found" ] && [ -f "$_mmn_found/.claude/.workspace" ]; then
  export MEMNYX_WORKSPACE="$_mmn_found"
else
  export MEMNYX_WORKSPACE="$_mmn_baked_ws"
fi
unset _mmn_baked_ws _mmn_self _mmn_found

# mmn — launch Claude with the memnyx workspace attached.
#   mmn              launch in the current folder, with the workspace added
#   mmn <slug>       jump to a registered project's clone, then launch
#   mmn -<flag> ...  launch in the current folder, passing flags through to claude
#
# Before launching it prints a banner showing the directory it will cd into and
# the exact command it runs, so there is no hidden behaviour.
#
# The clone-jump resolves the REAL path of <workspace>/projects/<slug> (via
# cd + `pwd -P`, since stock macOS has no `realpath`), so the project's own
# .mcp.json/settings load — launching from the symlink path would load the
# workspace's instead. An unrecognised slug is refused, never guessed.
mmn() {
  _mmn_ws="$MEMNYX_WORKSPACE"
  if [ -z "$_mmn_ws" ]; then
    echo "mmn: MEMNYX_WORKSPACE is not set — re-run /setup-workspace" >&2
    return 1
  fi
  case "$1" in
    "" | here | .)
      if [ "$1" = here ] || [ "$1" = . ]; then shift; fi
      _mmn_warn_if_workspace_missing
      _mmn_run "" "$@"
      ;;
    -*)
      _mmn_warn_if_workspace_missing
      _mmn_run "" "$@"
      ;;
    *)
      # A slug is a single directory name. Reject path-like tokens (., .., or
      # anything with a slash) so projects/$1 can't traverse out of projects/.
      case "$1" in
        "" | . | .. | */*)
          echo "mmn: '$1' is not a registered project under $_mmn_ws/projects/" >&2
          return 1
          ;;
      esac
      if [ ! -d "$_mmn_ws" ]; then
        echo "mmn: the workspace folder $_mmn_ws does not exist, so project '$1' cannot be found — run /setup-workspace sync to regenerate this file" >&2
        return 1
      fi
      _mmn_dir=$(\cd "$_mmn_ws/projects/$1" >/dev/null 2>&1 && pwd -P)
      if [ -n "$_mmn_dir" ] && [ -d "$_mmn_dir" ]; then
        shift
        _mmn_run "$_mmn_dir" "$@"
      else
        echo "mmn: '$1' is not a registered project under $_mmn_ws/projects/" >&2
        return 1
      fi
      ;;
  esac
}

# Launching in the current folder does not need the workspace folder, so a missing
# one only earns a warning; looking up a project by name does need it and refuses.
_mmn_warn_if_workspace_missing() {
  if [ ! -d "$_mmn_ws" ]; then
    echo "mmn: warning — the workspace folder $_mmn_ws does not exist; launching without it. Run /setup-workspace sync to regenerate this file." >&2
  fi
}

# _mmn_run <target-dir-or-empty> [claude args...] — announce, cd if asked, launch.
_mmn_run() {
  _mmn_tgt="$1"
  shift
  if [ -t 1 ]; then
    _mmn_hd=$(printf '\033[1;36m'); _mmn_dm=$(printf '\033[2m'); _mmn_rs=$(printf '\033[0m')
  else
    _mmn_hd=; _mmn_dm=; _mmn_rs=
  fi
  if [ -n "$_mmn_tgt" ]; then
    _mmn_where="$_mmn_tgt"
  else
    _mmn_where="$(pwd -P)  (current folder)"
  fi
  # The compaction-safeguard hooks are wired in the workspace's settings.json,
  # which Claude Code loads only when it starts at the workspace root itself.
  # Anywhere else (a project's clone, a subfolder) mmn passes the same three
  # hooks with --settings; hooks given that way are added to the folder's own.
  # The commands name $MEMNYX_WORKSPACE rather than a path. At the root nothing
  # is added, so the hooks never fire twice.
  #
  # The context gauge (statusline.sh) comes along the same way, but only when no
  # status line is set in your user settings or the folder's own: a status line
  # is one setting, not a list, and one given with --settings would replace yours.
  # The check is a plain text match for "statusLine", on purpose: it can only err
  # towards no gauge, never towards replacing a status line it failed to parse.
  if [ -n "$_mmn_tgt" ]; then _mmn_dest="$_mmn_tgt"; else _mmn_dest=$(pwd -P); fi
  _mmn_wsp=$(CDPATH= \cd -- "$_mmn_ws" >/dev/null 2>&1 && pwd -P)
  _mmn_hooks= _mmn_gauge= _mmn_kept=
  if [ -n "$_mmn_wsp" ] && [ "$_mmn_dest" != "$_mmn_wsp" ] \
      && [ -f "$_mmn_wsp/.claude/hooks/memnyx/compaction.sh" ]; then
    _mmn_hooks='{"hooks":{"PreCompact":[{"matcher":"*","hooks":[{"type":"command","command":"bash \"$MEMNYX_WORKSPACE\"/.claude/hooks/memnyx/compaction.sh pre","timeout":10}]}],"PostCompact":[{"matcher":"*","hooks":[{"type":"command","command":"bash \"$MEMNYX_WORKSPACE\"/.claude/hooks/memnyx/compaction.sh post","timeout":10}]}],"SessionStart":[{"matcher":"compact","hooks":[{"type":"command","command":"bash \"$MEMNYX_WORKSPACE\"/.claude/hooks/memnyx/compaction.sh resume","timeout":10}]}]}}'
    _mmn_gauge=yes
    for _mmn_f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" \
        "$_mmn_dest/.claude/settings.json" "$_mmn_dest/.claude/settings.local.json"; do
      if [ -z "$_mmn_kept" ] && \grep -qs '"statusLine"' "$_mmn_f"; then
        _mmn_gauge= _mmn_kept="$_mmn_f"
      fi
    done
    [ -f "$_mmn_wsp/.claude/hooks/memnyx/statusline.sh" ] || _mmn_gauge= _mmn_kept=
    if [ -n "$_mmn_gauge" ]; then
      _mmn_hooks="${_mmn_hooks%?}"',"statusLine":{"type":"command","command":"bash \"$MEMNYX_WORKSPACE\"/.claude/hooks/memnyx/statusline.sh"}}'
    fi
  fi
  printf '\n%s  mmn ▸ launching Claude%s\n' "$_mmn_hd" "$_mmn_rs"
  printf '%s  ├─ cd  %s %s\n' "$_mmn_dm" "$_mmn_rs" "$_mmn_where"
  if [ -n "$_mmn_hooks" ]; then
    printf '%s  ├─ hooks %s compaction safeguard added with --settings (not at the workspace root, so its settings.json does not load)\n' "$_mmn_dm" "$_mmn_rs"
    if [ -n "$_mmn_gauge" ]; then
      printf '%s  ├─ gauge %s context gauge added too (no status line set in your settings or this folder'"'"'s)\n' "$_mmn_dm" "$_mmn_rs"
      _mmn_what='compaction hooks + gauge'
    else
      [ -n "$_mmn_kept" ] && printf '%s  ├─ gauge %s not added: kept the status line set in %s\n' "$_mmn_dm" "$_mmn_rs" "$_mmn_kept"
      _mmn_what='compaction hooks'
    fi
    printf '%s  └─ run %s CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude --add-dir %s --settings <%s> %s\n\n' "$_mmn_dm" "$_mmn_rs" "$_mmn_ws" "$_mmn_what" "$*"
  else
    printf '%s  └─ run %s CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude --add-dir %s %s\n\n' "$_mmn_dm" "$_mmn_rs" "$_mmn_ws" "$*"
  fi
  if [ -n "$_mmn_tgt" ]; then
    \cd "$_mmn_tgt" || return 1
  fi
  if [ -n "$_mmn_hooks" ]; then
    CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude --add-dir "$_mmn_ws" --settings "$_mmn_hooks" "$@"
  else
    CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude --add-dir "$_mmn_ws" "$@"
  fi
}
