# memnyx shell helpers — GENERATED by /setup-workspace (init/sync).
# Do not edit: this file is overwritten on every sync. Sourced from your shell
# profile via a managed block. POSIX-safe — works under sh, bash, and zsh.

# Value is shell-quoted by launcher.py (shlex.quote) — do NOT add quotes here.
export MEMNYX_WORKSPACE={{workspace_path}}

# mmn — launch Claude with the memnyx workspace attached.
#   mmn              launch in the current folder, with the workspace added
#   mmn <slug>       jump to a registered project's clone, then launch
#   mmn -<flag> ...  launch in the current folder, passing flags through to claude
#
# Before launching it prints a banner showing the directory it will cd into and
# the exact command it runs, so there is no hidden behaviour.
#
# The clone-jump resolves the REAL path of <workspace>/projects/<slug> (via
# cd + `pwd -P`, since stock macOS has no `realpath`), so the project's own
# .mcp.json/settings load — launching from the symlink path would load the
# workspace's instead. An unrecognised slug is refused, never guessed.
mmn() {
  _mmn_ws="$MEMNYX_WORKSPACE"
  if [ -z "$_mmn_ws" ]; then
    echo "mmn: MEMNYX_WORKSPACE is not set — re-run /setup-workspace" >&2
    return 1
  fi
  case "$1" in
    "" | here | .)
      if [ "$1" = here ] || [ "$1" = . ]; then shift; fi
      _mmn_run "" "$@"
      ;;
    -*)
      _mmn_run "" "$@"
      ;;
    *)
      # A slug is a single directory name. Reject path-like tokens (., .., or
      # anything with a slash) so projects/$1 can't traverse out of projects/.
      case "$1" in
        "" | . | .. | */*)
          echo "mmn: '$1' is not a registered project under $_mmn_ws/projects/" >&2
          return 1
          ;;
      esac
      _mmn_dir=$(cd "$_mmn_ws/projects/$1" 2>/dev/null && pwd -P)
      if [ -n "$_mmn_dir" ] && [ -d "$_mmn_dir" ]; then
        shift
        _mmn_run "$_mmn_dir" "$@"
      else
        echo "mmn: '$1' is not a registered project under $_mmn_ws/projects/" >&2
        return 1
      fi
      ;;
  esac
}

# _mmn_run <target-dir-or-empty> [claude args...] — announce, cd if asked, launch.
_mmn_run() {
  _mmn_tgt="$1"
  shift
  if [ -t 1 ]; then
    _mmn_hd=$(printf '\033[1;36m'); _mmn_dm=$(printf '\033[2m'); _mmn_rs=$(printf '\033[0m')
  else
    _mmn_hd=; _mmn_dm=; _mmn_rs=
  fi
  if [ -n "$_mmn_tgt" ]; then
    _mmn_where="$_mmn_tgt"
  else
    _mmn_where="$(pwd -P)  (current folder)"
  fi
  printf '\n%s  mmn ▸ launching Claude%s\n' "$_mmn_hd" "$_mmn_rs"
  printf '%s  ├─ cd  %s %s\n' "$_mmn_dm" "$_mmn_rs" "$_mmn_where"
  printf '%s  └─ run %s CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude --add-dir %s %s\n\n' "$_mmn_dm" "$_mmn_rs" "$_mmn_ws" "$*"
  if [ -n "$_mmn_tgt" ]; then
    cd "$_mmn_tgt" || return 1
  fi
  CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude --add-dir "$_mmn_ws" "$@"
}
